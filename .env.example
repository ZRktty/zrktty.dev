# This is an example of a local environment file for a Next.js project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Change this to your dataset name, eg 'development' or 'staging' or 'production'
NEXT_PUBLIC_SANITY_DATASET=production
# Change this to your Sanity API version, eg '2024-02-09'
NEXT_PUBLIC_SANITY_API_VERSION=2024-02-09
SANITY_API_TOKEN=
# PostHog EU analytics — Project API key from app.eu.posthog.com > Project Settings
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Vercel Feature Flags — copy from Vercel Dashboard > Project Settings > Environment Variables
FLAGS_SECRET=
