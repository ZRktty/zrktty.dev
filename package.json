{
  "name": "zrktty.dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "prepare": "husky",
    "security:scan": "gitleaks detect --source=. --verbose",
    "security:baseline": "gitleaks detect --source . --report-path .gitleaks-report.json",
    "export:banner": "bun scripts/export-banner.ts",
    "tunnel": "ngrok http 3000 --domain=commonly-amazing-monkey.ngrok-free.app",
    "setup": "bun install && node scripts/init-claude.mjs"
  },
  "lint-staged": {
    "src/!(components/ui)/**/*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": "prettier --write"
  },
  "dependencies": {
    "@flags-sdk/vercel": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@sanity/image-url": "2.1.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vercel/analytics": "^2.0.1",
    "botid": "^1.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flags": "^4.0.6",
    "framer-motion": "^12.23.5",
    "lucide-react": "^0.525.0",
    "next": "16.2.6",
    "next-sanity": "12.3.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "posthog-js": "^1.374.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-syntax-highlighter": "^15.6.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.16.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.31.0",
    "eslint-config-next": "16.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "puppeteer-core": "^25.0.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  }
}
