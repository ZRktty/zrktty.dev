{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit -m '*)",
      "Bash(git push *)",
      "Bash(gh pr *)",
      "Bash(bun run lint)",
      "mcp__MCP_DOCKER__jira_get_issue",
      "mcp__claude_ai_Atlassian__getJiraIssue",
      "mcp__MCP_DOCKER__fetch",
      "WebFetch(domain:codepen.io)",
      "mcp__MCP_DOCKER__browser_console_messages",
      "mcp__MCP_DOCKER__browser_evaluate",
      "mcp__MCP_DOCKER__browser_click",
      "mcp__MCP_DOCKER__browser_snapshot",
      "WebSearch",
      "Bash(lsof -ti:3000)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000/cv/sosafe)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -o pipefail -c \"bun run lint --max-warnings=0 2>&1 | tail -20\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code needs your input\" with title \"zrktty.dev\" sound name \"Glass\"'"
          }
        ]
      }
    ]
  }
}
