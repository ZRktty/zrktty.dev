{
  "mcpServers": {
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "next-devtools": {
      "command": "bunx",
      "args": ["next-devtools-mcp@latest"]
    },
    "playwright": {
      "command": "bunx",
      "args": [
        "@playwright/mcp@latest",
        "--browser=chrome",
        "--viewport-size=375,667",
        "--save-session"
      ]
    },
    "sanity": {
      "type": "http",
      "url": "https://mcp.sanity.io"
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp"
    }
  }
}
